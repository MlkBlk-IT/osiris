# Environnement virtuel isolé
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Outils
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage.xml
htmlcov/

# Données runtime (conservées localement, non versionnées)
data/*
!data/.gitkeep

# Secrets
.env
.env.*

# Packaging / publication
node_modules/
*.egg-info/
dist/
npm/*.tgz
.venv-pkgtest/
.pytest-tmp/

# Sauvegardes et logs locaux (jamais dans la distribution)
*.bak*
_backup_*/
_livetest/
*.log

